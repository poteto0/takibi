package code

templ Bindingstypesgo() {
	@templ.Raw(
		`
			<pre class="chroma"><code><span class="kd">type</span> <span class="nx">Bindings</span> <span class="kd">struct</span> <span class="p">&#123;</span>
	<span class="nx">ApiKey</span> <span class="kt">string</span>                  <span class="s">&#96;</span><span class="s">env:&#34;API_KEY&#34;</span><span class="s">&#96;</span>         <span class="c1">// env var / secret</span>
	<span class="nx">Store</span>  <span class="o">*</span><span class="nx">kv</span><span class="p">.</span><span class="nx">Namespace</span>           <span class="s">&#96;</span><span class="s">cfbinding:&#34;MY_KV&#34;</span><span class="s">&#96;</span>     <span class="c1">// KV namespace</span>
	<span class="nx">Bucket</span> <span class="o">*</span><span class="nx">r2</span><span class="p">.</span><span class="nx">Bucket</span>              <span class="s">&#96;</span><span class="s">cfbinding:&#34;MY_BUCKET&#34;</span><span class="s">&#96;</span> <span class="c1">// R2 bucket</span>
	<span class="nx">DB</span>     <span class="o">*</span><span class="nx">sql</span><span class="p">.</span><span class="nx">DB</span>                 <span class="s">&#96;</span><span class="s">cfbinding:&#34;MY_DB&#34;</span><span class="s">&#96;</span>     <span class="c1">// D1 database</span>
	<span class="nx">AI</span>     <span class="o">*</span><span class="nx">cfextensions</span><span class="p">.</span><span class="nx">WorkersAi</span> <span class="s">&#96;</span><span class="s">cfbinding:&#34;AI&#34;</span><span class="s">&#96;</span>        <span class="c1">// Workers AI</span>
	<span class="nx">Raw</span>    <span class="nx">js</span><span class="p">.</span><span class="nx">Value</span>                <span class="s">&#96;</span><span class="s">cfbinding:&#34;MY_QUEUE&#34;</span><span class="s">&#96;</span>  <span class="c1">// anything else</span>
<span class="p">&#125;</span></code></pre>
		`,
	)
}
